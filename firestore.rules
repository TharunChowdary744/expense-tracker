rules_version = '2';

// Rules v1 (phase 2).
// - users/{uid} and everything below it is readable and writable only by that user.
// - Everything else is denied by default. Later phases add their own match blocks
//   (groups, invites, ...) together with tests in rules-tests/.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
