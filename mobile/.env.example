# Copy to .env.local (git-ignored) and fill in. Expo bakes EXPO_PUBLIC_* values into the app
# when it bundles, so these are public config, not secrets. See README.md.

# The same Firebase project as the web app: the values from a Firebase *web* app config
# (Project settings > General > Your apps). The JS SDK uses them on iOS and Android too.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local Firebase emulators. From the Android emulator use 10.0.2.2; from a phone, your
# computer's LAN IP.
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

# Google sign-in: OAuth client IDs from Google Cloud Console > APIs & Services > Credentials,
# in the Firebase project's Google Cloud project. Leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# The deployed web app's address (e.g. https://<user>.github.io/expense-tracker). Group
# invite links point here so anyone can open them.
EXPO_PUBLIC_WEB_APP_URL=

# Receipts (Firebase Storage) are off unless this is "true", as on the web app.
EXPO_PUBLIC_RECEIPTS_ENABLED=false
