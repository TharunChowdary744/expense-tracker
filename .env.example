# Copy to .env.local (git-ignored) and fill in your dev Firebase web app config.
# CI and deploys read these from GitHub Environment secrets instead. See docs/DEPLOYMENT.md.
VITE_APP_ENV=local
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
# Receipts (Firebase Storage) are off unless this is "true".
VITE_RECEIPTS_ENABLED=false
